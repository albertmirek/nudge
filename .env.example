# Copy to .env — docker compose and the server read this file.

# PostgreSQL (db container)
POSTGRES_USER=nudge
POSTGRES_PASSWORD=nudge
POSTGRES_DB=nudge
POSTGRES_PORT=5432

# NestJS server
PORT=3000
# Used when running the server natively against `pnpm docker:db`.
# Inside docker compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql://nudge:nudge@localhost:5432/nudge

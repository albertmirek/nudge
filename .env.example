# Copy to .env — docker compose and the server read this file.

# PostgreSQL (db container)
POSTGRES_USER=nudge
POSTGRES_PASSWORD=nudge
POSTGRES_DB=nudge
POSTGRES_PORT=5432

# NestJS server
PORT=3000
# Used when running the server natively against `pnpm docker:db`.
# Inside docker compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql://nudge:nudge@localhost:5432/nudge

# Authentication (server)
# ≥ 32 random characters; outside production a fixed dev secret is used when empty.
AUTH_JWT_SECRET=
AUTH_REFRESH_IDLE_DAYS=180
AUTH_REFRESH_MAX_DAYS=730

# Transactional email (Resend). Empty outside production logs emails to the console.
RESEND_API_KEY=
EMAIL_FROM=Nudge <no-reply@example.com>

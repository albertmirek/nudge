meta {
  name: Reset Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/auth/reset-password
  body: json
}

body:json {
  {
    "email": "{{email}}",
    "code": "{{code}}",
    "newPassword": "{{password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.accessToken);
    bru.setEnvVar("refreshToken", res.body.refreshToken);
  }
}

docs {
  Resets the password and signs the user in with new tokens.
}

meta {
  name: Create Catch-up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/friends/{{friendId}}/catch-up
  body: json
}

body:json {
  {
    "note": "Coffee catch-up"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("catchUpId", res.body.id);
  }
}

docs {
  note is required and non-empty. A catch-up is a note about the friend; it never
  changes lastContactAt or the nudge (use "Confirm Nudge" to record contact).
}

meta {
  name: Create Catch-up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/friends/{{friendId}}/catch-up
  body: json
}

body:json {
  {
    "note": "Coffee catch-up"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("catchUpId", res.body.id);
  }
}

docs {
  note is optional (omit it or send null). Recording a catch-up sets the friend's
  lastContactAt and replans its nudge — run "Get Friend" afterwards to refresh {{revision}}.
}
